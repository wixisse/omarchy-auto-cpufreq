#!/usr/bin/env bash
# Auto CPU Freq — read-only auto-cpufreq state probe.
#
# Prints tab-separated "key<TAB>value" lines consumed by Service.qml, mirroring
# the omarchy-battery-status --shell format. No root is required: the governor,
# EPP, turbo and platform profile are read straight from sysfs and the daemon's
# saved overrides are read from its root-owned pickle files.
set -uo pipefail
export LC_ALL=C
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

out() { printf '%s\t%s\n' "$1" "$2"; }

# --- installed / running ---------------------------------------------------
installed=0
command -v auto-cpufreq >/dev/null 2>&1 && installed=1

active=0
systemctl is-active --quiet auto-cpufreq.service 2>/dev/null && active=1

version=""
if (( installed )); then
  version=$(pacman -Q auto-cpufreq 2>/dev/null | awk '{print $2}')
  [[ -z $version ]] && version=$(auto-cpufreq --version 2>/dev/null |
    sed -n 's/^auto-cpufreq version: *//p' | head -n1)
fi

# --- saved overrides -------------------------------------------------------
# These are Python pickles of a single short string written by the daemon.
# Extract the embedded token with `strings` instead of unpickling.
pickle_token() { # <file> <default> <candidate-1> [candidate-2 ...]
  local file=$1 default=$2 pattern token
  shift 2
  pattern=$(IFS='|'; echo "$*")
  if [[ -r $file ]]; then
    token=$(strings -n 3 "$file" 2>/dev/null |
      grep -aoE "$pattern" | head -n1)
  fi
  echo "${token:-$default}"
}

force=$(pickle_token /opt/auto-cpufreq/override.pickle auto powersave performance)
turbo_override=$(pickle_token /opt/auto-cpufreq/turbo-override.pickle auto always never)

# --- live CPU state --------------------------------------------------------
governor=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)
epp=$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null)

turbo=unknown
if [[ -r /sys/devices/system/cpu/intel_pstate/no_turbo ]]; then
  [[ $(cat /sys/devices/system/cpu/intel_pstate/no_turbo 2>/dev/null) == 0 ]] \
    && turbo=on || turbo=off
elif [[ -r /sys/devices/system/cpu/cpufreq/boost ]]; then
  [[ $(cat /sys/devices/system/cpu/cpufreq/boost 2>/dev/null) == 1 ]] \
    && turbo=on || turbo=off
fi

platform_profile=$(cat /sys/firmware/acpi/platform_profile 2>/dev/null)
platform_profiles=$(cat /sys/firmware/acpi/platform_profile_choices 2>/dev/null)

# --- emit ------------------------------------------------------------------
out installed "$installed"
out active "$active"
out version "${version:--}"
out force "$force"
out turbo_override "$turbo_override"
out governor "${governor:--}"
out epp "${epp:--}"
out turbo "$turbo"
out platform_profile "${platform_profile:--}"
out platform_profiles "${platform_profiles:--}"
